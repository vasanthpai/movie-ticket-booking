# Copy this file to `.env` and fill in real values. Never commit `.env`.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string (required).
# Atlas: Database → Connect → Drivers. Put the database name after the host,
# e.g. ...mongodb.net/movie_booking?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/movie_booking
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/movie_booking?retryWrites=true&w=majority

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
